{
  "name": "katarakt",
  "version": "1.0.0",
  "description": "Browser Security Sentinel - Multi-layered browser hardening with Cloudflare and Google Cloud integration",
  "main": "cloudflare-worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "serve": "npx serve . -p 3000",
    "gcp:build": "docker build -t gcr.io/$PROJECT_ID/katarakt-backend .",
    "gcp:push": "docker push gcr.io/$PROJECT_ID/katarakt-backend",
    "gcp:deploy": "gcloud run services replace google-cloud-run.yaml",
    "tail": "wrangler tail",
    "test": "node --test"
  },
  "keywords": [
    "security",
    "browser",
    "fingerprinting",
    "privacy",
    "cloudflare",
    "workers",
    "google-cloud",
    "mullvad",
    "hardening",
    "pentesting"
  ],
  "author": "Katarakt Security",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NubleX/katarakt.git"
  },
  "homepage": "https://shield.idarti.com",
  "bugs": {
    "url": "https://github.com/NubleX/katarakt/issues"
  },
  "type": "module"
}
